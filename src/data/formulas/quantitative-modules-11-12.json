  {
    "id": "mc-log-return-11",
    "name": "Simulated one-step log return",
    "expression": "r_t = (r_f − σ²/2)s + σ√s X",
    "meaning": "Generates a log return under a geometric Brownian motion assumption.",
    "variables": {
      "r_t": "simulated log return",
      "r_f": "risk-free rate or drift",
      "σ": "volatility",
      "s": "step size in years",
      "X": "standard-normal draw"
    },
    "intuition": "Combines volatility-adjusted drift with a scaled random shock.",
    "workedExample": "With r_f=5%, σ=25%, s=1, X=0, r_t=1.875%.",
    "commonMistake": "Omitting the −σ²/2 adjustment.",
    "relatedLessonId": "quant-simulation-11",
    "scopeStatement": "SM-03: Describe Monte Carlo simulation and explain its investment applications.",
    "tags": [
      "simulation"
    ],
    "studyLessonId": "quant-simulation-11",
    "officialModuleId": "QM-LM9",
    "supplementary": false,
    "relatedLearningOutcome": "describe Monte Carlo simulation and explain how it can be used in investment applications"
  },
