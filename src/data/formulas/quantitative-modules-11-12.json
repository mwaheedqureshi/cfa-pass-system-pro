  {
    "id": "historical-log-return-11",
    "name": "Historical log return",
    "expression": "r_t = ln(P_t / P_{t-1})",
    "meaning": "Continuously compounded change used to construct historical scenarios.",
    "variables": {
      "r_t": "log return",
      "P_t": "current price",
      "P_{t-1}": "previous price"
    },
    "intuition": "The log price relative converts successive prices into additive log changes.",
    "workedExample": "ln(20,145.29 / 19,781.41) = 0.0182, or 1.82%.",
    "commonMistake": "Using a simple percentage change while labeling it a log return.",
    "relatedLessonId": "quant-simulation-11",
    "scopeStatement": "SM-01: Describe historical simulation and explain its investment applications.",
    "tags": [
      "simulation"
    ],
    "studyLessonId": "quant-simulation-11",
    "officialModuleId": "QM-LM9",
    "supplementary": false,
    "relatedLearningOutcome": "describe historical simulation and explain how it can be used in investment applications"
  },
